# ==============================================================
# ORBIVISION Frontend — Environment Configuration
# ==============================================================

# Backend API Base URL
# - In production on Render (Static Site), set this to your Render Web Service URL:
#   VITE_API_BASE_URL=https://orbivision-api.onrender.com
# - In local development or Docker Nginx setups, leave it blank (routes via relative /api):
#   VITE_API_BASE_URL=
#
# SECURITY NOTE:
# Only variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER define backend secrets, JWT keys, SMTP credentials, or passwords in frontend configs.
VITE_API_BASE_URL=
